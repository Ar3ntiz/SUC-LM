#!/bin/bash
set -euo pipefail
CURRENT="${3%/}/Applications/SUC Studio.app"
if [[ -L "$CURRENT" ]]; then
  echo 'Installazione interrotta: SUC Studio.app è un collegamento simbolico.' >&2
  exit 1
fi
if [[ -e "$CURRENT" ]]; then
  ID=$(/usr/libexec/PlistBuddy -c 'Print CFBundleIdentifier' "$CURRENT/Contents/Info.plist" 2>/dev/null || true)
  case "$ID" in
    local.sucstudio.app|local.sucstudio.universal.app) ;;
    *) echo 'Installazione interrotta: SUC Studio.app ha un identificativo sconosciuto.' >&2; exit 1;;
  esac
fi
exit 0
