    uint t = thread_position_in_threadgroup.x;
    uint gy = threadgroup_position_in_grid.y;
    uint b = threadgroup_position_in_grid.z;
    threadgroup float buf[BUFQ];
    if (gy < GE0) suc_blocks_row<M0, P0, Q, T, C, INV>(x + b * NTOT + OFF0, signs + ulong(sidx[b]) * NTOT + OFF0, y + b * NTOT + OFF0, gy - GS0, buf, t);
}

// ====================================================================================================
// suc_switch_residual: suc.kernels.suc_switch._RESIDUAL_SRC (gather_residual_metal)
// ====================================================================================================

template <typename TX, typename TC, typename TV, int IN, int OUT>
[[kernel]] void suc_switch_residual(
    const device TX* x [[buffer(0)]],
    const device float* y_in [[buffer(1)]],
    const device uint32_t* row_ptr [[buffer(2)]],
    const device TC* cols [[buffer(3)]],
    const device TV* vals [[buffer(4)]],
    const device float* scale [[buffer(5)]],
    const device uint32_t* eidx [[buffer(6)]],
    device float* y [[buffer(7)]],
    uint3 thread_position_in_grid [[thread_position_in_grid]],
    uint3 thread_position_in_threadgroup [[thread_position_in_threadgroup]],
    uint3 threadgroup_position_in_grid [[threadgroup_position_in_grid]],
    uint3 threads_per_threadgroup [[threads_per_threadgroup]],
    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]],
    uint thread_index_in_simdgroup [[thread_index_in_simdgroup]]) {

    uint r = thread_position_in_grid.x;
    uint b = thread_position_in_grid.y;
    if (r >= OUT) return;
    uint e = eidx[b];
    ulong rr = ulong(e) * OUT + r;
    float acc = 0.0f;
    for (uint j = row_ptr[rr]; j < row_ptr[rr + 1]; ++j)
        acc += float(x[ulong(b) * IN + cols[j]]) * float(vals[j]);
    y[ulong(b) * OUT + r] = y_in[ulong(b) * OUT + r] + scale[e] * acc;
}

// ====================================================================================================
// suc_switch_structured_residual: suc.kernels.suc_switch._COLRES_SRC (switch_structured_residual_metal)
// ====================================================================================================

template <typename TX, typename TCC, typename TCV, typename TRC, typename TRV, int IN, int OUT, int CMAX, int RQ, int JS,
          int RED, bool HAS_CSR, typename OT>
[[kernel]] void suc_switch_structured_residual(
    const device TX* x [[buffer(0)]],
    const device float* y_in [[buffer(1)]],
    const device uint32_t* eidx [[buffer(2)]],
    const device uint32_t* cptr [[buffer(3)]],
    const device TCC* ccols [[buffer(4)]],
    const device TCV* cval [[buffer(5)]],
    const device float* cscale [[buffer(6)]],
    const device uint32_t* row_ptr [[buffer(7)]],
    const device TRC* rcols [[buffer(8)]],
    const device TRV* rvals [[buffer(9)]],
    const device float* rscale [[buffer(10)]],
    device OT* y [[buffer(11)]],
    uint3 thread_position_in_grid [[thread_position_in_grid]],
    uint3 thread_position_in_threadgroup [[thread_position_in_threadgroup]],
    uint3 threadgroup_position_in_grid [[threadgroup_position_in_grid]],
    uint3 threads_per_threadgroup [[threads_per_threadgroup]],
    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]],
    uint thread_index_in_simdgroup [[thread_index_in_simdgroup]]) {

    constexpr uint TR = 32 * RQ;
    uint tid = thread_position_in_threadgroup.x;
    uint tn = threads_per_threadgroup.x;
    uint lane = tid % 32, js = tid / 32;
    uint b = threadgroup_position_in_grid.y;
    uint e = eidx[b];
    uint rt0 = threadgroup_position_in_grid.x * TR;
    uint r0 = rt0 + lane * RQ;
    ulong xb = ulong(b) * IN;
    threadgroup float xg[CMAX];
    threadgroup float red[RED];
    uint j0 = cptr[e];
    uint nc = cptr[e + 1] - j0;
    for (uint t = tid; t < nc; t += tn) xg[t] = float(x[xb + ccols[j0 + t]]) * cscale[j0 + t];
    threadgroup_barrier(mem_flags::mem_threadgroup);
    float acc[RQ];
    for (uint q = 0; q < RQ; ++q) acc[q] = 0.0f;
    if (r0 < OUT) {
        for (uint j = js; j < nc; j += JS) {
            ulong qb = ulong(j0 + j) * OUT + r0;
            float w[RQ];
            if (RQ == 4) {
                float4 v = suc_ld4(cval + qb);
                w[0] = v.x; w[RQ > 1 ? 1 : 0] = v.y; w[RQ > 2 ? 2 : 0] = v.z; w[RQ > 3 ? 3 : 0] = v.w;
            } else {
                for (uint q = 0; q < RQ; ++q) w[q] = float(cval[qb + q]);
            }
            float xv = xg[j];
            for (uint q = 0; q < RQ; ++q) acc[q] += w[q] * xv;
        }
        if (HAS_CSR) {
            float sc = rscale[e];
            for (uint q = 0; q < RQ; ++q) {
                uint r = r0 + q;
                if (r >= OUT) break;
                ulong rr = ulong(e) * OUT + r;
                uint k1 = row_ptr[rr + 1];
                for (uint k = row_ptr[rr] + js; k < k1; k += JS) {
                    float wv = sc * float(rvals[k]);
                    acc[q] += wv * float(x[xb + rcols[k]]);
                }
            }
        }
    }
    ulong yb = ulong(b) * OUT;
    if (JS > 1) {
        for (uint q = 0; q < RQ; ++q) red[js * TR + lane * RQ + q] = acc[q];
        threadgroup_barrier(mem_flags::mem_threadgroup);
        for (uint t = tid; t < TR; t += tn) {
            uint r = rt0 + t;
            if (r >= OUT) continue;
            float v = 0.0f;
            for (uint s = 0; s < JS; ++s) v += red[s * TR + t];
            y[yb + r] = OT(y_in[yb + r] + v);
        }
    } else {
        for (uint q = 0; q < RQ; ++q) {
            uint r = r0 + q;
            if (r >= OUT) break;
            y[yb + r] = OT(y_in[yb + r] + acc[q]);
        }
    }
}

// ====================================================================================================
// suc.kernels.tcq_matmul._TCQ_HEADER
// ====================================================================================================

constexpr uint suc_tcq_a(int code, int j) { return j == 0 ? (code == 0 ? 34038481u : 89226354u) : 2654435761u; }
constexpr uint suc_tcq_b(int code, int j) { return j == 0 ? (code == 0 ? 76625530u : 64248484u) : 1013904223u; }
template <int CODE, int V>
inline void suc_tcq_raw(uint st, thread float* raw) {
    if (CODE == 0) {                        // 1mad: byte sum of a*s+b
        for (int j = 0; j < V; ++j) {
            uint z = suc_tcq_a(0, j) * st + suc_tcq_b(0, j);
            uint u2 = (z & 0x00FF00FFu) + ((z >> 8) & 0x00FF00FFu);
            raw[j] = float((u2 & 0xFFFFu) + (u2 >> 16));
        }
    } else if (CODE == 1) {                 // 3inst: h.x + h.y of the masked word
        for (int j = 0; j < V; ++j) {
            half2 h = as_type<half2>(((suc_tcq_a(1, j) * st + suc_tcq_b(1, j)) & 0x8FFF8FFFu) ^ 0x3B603B60u);
            raw[j] = float(h.x) + float(h.y);
        }
    } else {                                // pair3 (V = 2): (h.x + h.y, h.x - h.y) of ONE word
        half2 h = as_type<half2>(((suc_tcq_a(1, 0) * st + suc_tcq_b(1, 0)) & 0x8FFF8FFFu) ^ 0x3B603B60u);
        raw[0] = float(h.x) + float(h.y);
        raw[V - 1] = float(h.x) - float(h.y);
    }
}

// ====================================================================================================
// suc_tcq_vec: suc.kernels.tcq_matmul._SRC (tcq_matmul_metal)
// ====================================================================================================
template <typename TXX, typename TSC, int L, int V, int KV, int T, int NW, int IN, int OUT, int BT, int CODE,
          int SG, int R, typename TO>
[[kernel]] void suc_tcq_vec(
    const device TXX* x [[buffer(0)]],
    const device uint32_t* words [[buffer(1)]],
    const device TSC* scales [[buffer(2)]],
    const device float* cst [[buffer(3)]],
    device TO* y [[buffer(4)]],
    uint3 thread_position_in_grid [[thread_position_in_grid]],
    uint3 thread_position_in_threadgroup [[thread_position_in_threadgroup]],
    uint3 threadgroup_position_in_grid [[threadgroup_position_in_grid]],
    uint3 threads_per_threadgroup [[threads_per_threadgroup]],
    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]],
    uint thread_index_in_simdgroup [[thread_index_in_simdgroup]]) {

    constexpr uint MASKL = (1u << L) - 1u;
    constexpr uint N = NW * 32;                  // bits per sequence
    constexpr uint SPL = T / (V * 32);           // steps per lane
    constexpr uint WPL = T / 32;                 // weights per lane
    constexpr uint NSEQ = IN / T;
    // words a lane needs: its first window starts at bit p0 = (i0+1)*KV - L, its last one ends at (i0+SPL)*KV
    constexpr uint SPAN = (SPL - 1) * KV + L;
    constexpr uint NWL = (31 + SPAN + 31) / 32;  // words covering the lane's span at any bit offset

    uint lane = thread_index_in_simdgroup;
    uint row0 = (threadgroup_position_in_grid.x * SG + simdgroup_index_in_threadgroup) * R;
    if (row0 >= OUT) return;
    uint rows[R];
    for (int rr = 0; rr < R; ++rr) rows[rr] = min(row0 + rr, uint(OUT - 1));
    float acc[R][BT][V];
    for (int rr = 0; rr < R; ++rr) for (int b = 0; b < BT; ++b) for (int j = 0; j < V; ++j) acc[rr][b][j] = 0.0f;
    float sx[BT][V];
    for (int b = 0; b < BT; ++b) for (int j = 0; j < V; ++j) sx[b][j] = 0.0f;

    const uint i0 = lane * SPL;
    const int p0i = int((i0 + 1) * KV) - int(L);
    const uint p0 = uint(p0i + int(N)) % N;      // first window bit (circular)
    const uint w0 = p0 >> 5, off0 = p0 & 31;
    const uint w1 = w0 + 1 == NW ? 0u : w0 + 1;
    constexpr uint SPC = (32 - L) / KV + 1;      // steps whose windows fit one 32-bit register

    for (uint q = 0; q < NSEQ; ++q) {
        // x span of this lane (WPL consecutive inputs), shared by the R rows
        float xv[BT][WPL];
        for (int b = 0; b < BT; ++b) {
            for (uint e = 0; e < WPL; e += 4) {
                float4 v4 = suc_ld4(x + b * IN + q * T + lane * WPL + e);
                xv[b][e] = v4.x; xv[b][e + 1] = v4.y; xv[b][e + 2] = v4.z; xv[b][e + 3] = v4.w;
            }
            for (uint e = 0; e < WPL; ++e) sx[b][e % V] += xv[b][e];
        }
        for (int rr = 0; rr < R; ++rr) {
            const device uint* sw = words + (ulong(rows[rr]) * NSEQ + q) * NW;
            // The lane's windows are cut into chunks of SPC steps whose span fits one 32-bit register: one funnel
            // shift per chunk (row, sequence), then every window is a compile-time shift + mask of that register.
            uint wd[NWL];
            for (uint k2 = 0; k2 < NWL; ++k2) wd[k2] = sw[k2 == 0 ? w0 : (k2 == 1 ? w1 : (w0 + k2) % NW)];
            uint u = 0;
            #pragma clang loop unroll(full)
            for (uint t = 0; t < SPL; ++t) {
                if (t % SPC == 0) {
                    uint bit = off0 + t * KV;                // relative to word w0 (no wrap inside wd[])
                    uint wi = bit >> 5, o = bit & 31u;
                    uint hi = wd[min(wi + 1, NWL - 1)];
                    u = o == 0 ? wd[wi] : ((wd[wi] >> o) | (hi << (32u - o)));
                }
                uint st = (u >> ((t % SPC) * KV)) & MASKL;
                float raw[V];
                suc_tcq_raw<CODE, V>(st, raw);
                for (int b = 0; b < BT; ++b)
                    for (int j = 0; j < V; ++j) acc[rr][b][j] = fma(raw[j], xv[b][t * V + j], acc[rr][b][j]);
            }
        }
    }
    for (int b = 0; b < BT; ++b) for (int j = 0; j < V; ++j) sx[b][j] = simd_sum(sx[b][j]);
    for (int rr = 0; rr < R; ++rr) {
        uint row = row0 + rr;
        float s = float(scales[rows[rr]]);
        for (int b = 0; b < BT; ++b) {
            float tot = 0.0f;
            for (int j = 0; j < V; ++j) tot += cst[2 * j + 1] * (simd_sum(acc[rr][b][j]) - cst[2 * j] * sx[b][j]);
            if (lane == 0 && row < OUT) y[b * OUT + row] = static_cast<TO>(tot * s);
        }
    }
}

