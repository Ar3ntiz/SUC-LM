    uint b = threadgroup_position_in_grid.z;
    threadgroup float buf[BUFN];
    if (seg == 0) suc_rht_row<M0, P0, T, C0, INV, BUFN, HC>(x + b * NTOT + OFF0, signs + OFF0, hm + HO0, y + b * NTOT + OFF0, buf, t);
    if (seg == 1) suc_rht_row<M1, P1, T, C1, INV, BUFN, HC>(x + b * NTOT + OFF1, signs + OFF1, hm + HO1, y + b * NTOT + OFF1, buf, t);
    if (seg == 2) suc_rht_row<M2, P2, T, C2, INV, BUFN, HC>(x + b * NTOT + OFF2, signs + OFF2, hm + HO2, y + b * NTOT + OFF2, buf, t);
}

// ====================================================================================================
// suc_rot_row3_split: suc.kernels.rotation._kernel(nseg=3, split=True, row_signs=False)
// ====================================================================================================

template <typename TX, typename TY, int T, int INV, int BUFN, int HC, int NTOT, int M0, int P0, int C0, int OFF0, int HO0, int M1, int P1, int C1, int OFF1, int HO1, int M2, int P2, int C2, int OFF2, int HO2>
[[kernel]] void suc_rot_row3_split(
    const device TX* x [[buffer(0)]],
    const device float* signs [[buffer(1)]],
    const device float* hm [[buffer(2)]],
    device TY* y0 [[buffer(3)]],
    device TY* y1 [[buffer(4)]],
    device TY* y2 [[buffer(5)]],
    uint3 thread_position_in_grid [[thread_position_in_grid]],
    uint3 thread_position_in_threadgroup [[thread_position_in_threadgroup]],
    uint3 threadgroup_position_in_grid [[threadgroup_position_in_grid]],
    uint3 threads_per_threadgroup [[threads_per_threadgroup]],
    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]],
    uint thread_index_in_simdgroup [[thread_index_in_simdgroup]]) {
    uint t = thread_position_in_threadgroup.x;
    uint seg = threadgroup_position_in_grid.y;
    uint b = threadgroup_position_in_grid.z;
    threadgroup float buf[BUFN];
    if (seg == 0) suc_rht_row<M0, P0, T, C0, INV, BUFN, HC>(x + b * NTOT + OFF0, signs + OFF0, hm + HO0, y0 + b * P0 * M0, buf, t);
    if (seg == 1) suc_rht_row<M1, P1, T, C1, INV, BUFN, HC>(x + b * NTOT + OFF1, signs + OFF1, hm + HO1, y1 + b * P1 * M1, buf, t);
    if (seg == 2) suc_rht_row<M2, P2, T, C2, INV, BUFN, HC>(x + b * NTOT + OFF2, signs + OFF2, hm + HO2, y2 + b * P2 * M2, buf, t);
}

// ====================================================================================================
// suc_rot_prologue_row: suc.kernels.rotation._pro_kernel(outn=True)
// ====================================================================================================

template <int T, int BUFN, int HC, int M, int P, int C, int PRO, typename TX>
[[kernel]] void suc_rot_prologue_row(
    const device TX* x [[buffer(0)]],
    const device TX* w [[buffer(1)]],
    const device float* signs [[buffer(2)]],
    const device float* hm [[buffer(3)]],
    const device float* eps [[buffer(4)]],
    device TX* y [[buffer(5)]],
    device TX* xn [[buffer(6)]],
    uint3 thread_position_in_grid [[thread_position_in_grid]],
    uint3 thread_position_in_threadgroup [[thread_position_in_threadgroup]],
    uint3 threadgroup_position_in_grid [[threadgroup_position_in_grid]],
    uint3 threads_per_threadgroup [[threads_per_threadgroup]],
    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]],
    uint thread_index_in_simdgroup [[thread_index_in_simdgroup]]) {

    constexpr int PT = P / T;
    constexpr int E = M * PT;
    constexpr uint N = M * P;
    uint t = thread_position_in_threadgroup.x;
    uint b = threadgroup_position_in_grid.z;
    threadgroup float buf[BUFN];
    threadgroup float red[32];
    float v[E];
    if (PRO == 1) {
        SUC_UNROLL
        for (int e = 0; e < E; e += C) suc_ld<C>(x + b * N + suc_idx<P, T, C>(e, t), v + e);
        float ss = 0.0f;
        if (N <= 4096 && N <= BUFN) {        // MLX's order: the normed output is bit-identical to mx.fast.rms_norm
            SUC_UNROLL
            for (int e = 0; e < E; ++e) buf[suc_idx<P, T, C>(e, t)] = v[e];
            ss = suc_mlx_sumsq<N, T>(buf, red, t);
        } else {
            SUC_UNROLL
            for (int e = 0; e < E; ++e) ss += v[e] * v[e];
            ss = suc_tg_sum<T>(ss, red, t);
        }
        float r = metal::precise::rsqrt(ss / float(N) + eps[0]);
        SUC_UNROLL
        for (int e = 0; e < E; e += C) {
            float wv[C];
            suc_ld<C>(w + suc_idx<P, T, C>(e, t), wv);
            SUC_UNROLL
            for (int l = 0; l < C; ++l) v[e + l] = float(TX(wv[l] * float(TX(v[e + l] * r))));
        }
    } else {
        SUC_UNROLL
        for (int e = 0; e < E; e += C) {
            uint i = b * N + suc_idx<P, T, C>(e, t);
            float g[C], u[C];
            suc_ld<C>(x + i, g);
            suc_ld<C>(w + i, u);
            SUC_UNROLL
            for (int l = 0; l < C; ++l) v[e + l] = float(TX(g[l] / (1.0f + metal::exp(-g[l])) * u[l]));
        }
    }
    SUC_UNROLL
    for (int e = 0; e < E; e += C) {
        uint i = suc_idx<P, T, C>(e, t);
        suc_st<C>(xn + b * N + i, v + e);
        float sg[C];
        suc_ld<C>(signs + i, sg);
        SUC_UNROLL
        for (int l = 0; l < C; ++l) v[e + l] *= sg[l];
    }
    suc_rht_core<M, P, T, BUFN, HC, 0>(v, hm, buf, t);
    simdgroup_barrier(mem_flags::mem_none);   // see suc_rht_row
    const float sc = rsqrt(float(P));
    SUC_UNROLL
    for (int e = 0; e < E; e += C) {
        float o[C];
        SUC_UNROLL
        for (int l = 0; l < C; ++l) o[l] = v[e + l] * sc;
        suc_st<C>(y + b * N + suc_idx<P, T, C>(e, t), o);
    }

}

// ====================================================================================================
// suc_rot_dense: fallback for n = m * 2^k with 2^k < 32 (C++ only)
// ====================================================================================================

// y[b, i] = s(i) * sum_j Hm[a_i, a_j] * (-1)^popcount(c_i & c_j) * s'(j) * x[b, j] / sqrt(P)   (i = a_i * P + c_i)
// forward (INV = 0): s' = signs, s = 1; inverse (INV = 1): Hm transposed, s' = 1, s = signs. hm: (M, M) float32.
template <typename TX, typename TY, int M, int P, int INV>
[[kernel]] void suc_rot_dense(
    const device TX* x [[buffer(0)]],
    const device float* signs [[buffer(1)]],
    device TY* y [[buffer(2)]],
    const device float* hm [[buffer(3)]],
    uint3 thread_position_in_grid [[thread_position_in_grid]],
    uint3 thread_position_in_threadgroup [[thread_position_in_threadgroup]],
    uint3 threadgroup_position_in_grid [[threadgroup_position_in_grid]],
    uint3 threads_per_threadgroup [[threads_per_threadgroup]],
    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]],
    uint thread_index_in_simdgroup [[thread_index_in_simdgroup]]) {
    constexpr uint N = M * P;
    uint i = thread_position_in_grid.x;
    uint b = thread_position_in_grid.y;
    if (i >= N) return;
    uint ai = i / P, ci = i % P;
    float acc = 0.0f;
    for (uint j = 0; j < N; ++j) {
        uint aj = j / P, cj = j % P;
        float coef = (popcount(ci & cj) & 1) ? -1.0f : 1.0f;
        coef *= INV ? hm[aj * M + ai] : hm[ai * M + aj];
        float v = float(x[b * N + j]);
        if (!INV) v *= signs[j];
        acc += coef * v;
    }
    float o = acc * rsqrt(float(P));
    if (INV) o *= signs[i];
    y[b * N + i] = static_cast<TY>(o);
}

// ====================================================================================================
// suc_structured_residual: suc.runtime.compressed_model._STRUCT_SRC
// ====================================================================================================

template <typename TXX, typename TCC, typename TCV, typename TRC, typename TRV, int IN, int OUT, int S, int CTOT,
          int BT, int XG, int RQ, int JS, int RED, bool HAS_COLS, bool HAS_CSR, typename OT>
[[kernel]] void suc_structured_residual(
    const device TXX* x [[buffer(0)]],
    const device float* y_in [[buffer(1)]],
    const device uint32_t* meta [[buffer(2)]],
    const device TCC* ccols [[buffer(3)]],
    const device TCV* cval [[buffer(4)]],
    const device float* cscale [[buffer(5)]],
    const device uint32_t* row_ptr [[buffer(6)]],
    const device TRC* rcols [[buffer(7)]],
    const device TRV* rvals [[buffer(8)]],
    const device float* rscale [[buffer(9)]],
    device OT* y [[buffer(10)]],
    const constant int* x_shape [[buffer(11)]],
    uint3 thread_position_in_grid [[thread_position_in_grid]],
    uint3 thread_position_in_threadgroup [[thread_position_in_threadgroup]],
    uint3 threadgroup_position_in_grid [[threadgroup_position_in_grid]],
    uint3 threads_per_threadgroup [[threads_per_threadgroup]],
    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]],
    uint thread_index_in_simdgroup [[thread_index_in_simdgroup]]) {

    const uint B = x_shape[0];
    constexpr uint TR = 32 * RQ;                      // output rows per threadgroup
    uint tid = thread_position_in_threadgroup.x;
    uint tn = threads_per_threadgroup.x;              // 32 * JS
    uint lane = tid % 32, js = tid / 32;
    uint b0 = threadgroup_position_in_grid.y * BT;
    uint rt0 = threadgroup_position_in_grid.x * TR;
    uint r0 = rt0 + lane * RQ;
    threadgroup float xg[XG];
    threadgroup float red[RED];
    if (HAS_COLS) {
        for (uint t = tid; t < BT * CTOT; t += tn) {
            uint bb = t / CTOT, j = t - bb * CTOT;
            xg[t] = (b0 + bb < B) ? float(x[(b0 + bb) * IN + ccols[j]]) * cscale[j] : 0.0f;
        }
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    float acc[RQ][BT];
    for (uint q = 0; q < RQ; ++q) for (uint bb = 0; bb < BT; ++bb) acc[q][bb] = 0.0f;
    if (r0 < OUT) {
        uint m = 0;
        for (uint s = 1; s < S; ++s) m += uint(r0 >= meta[s]);
        if (HAS_COLS) {
            uint om = meta[m + 1] - meta[m];
            uint j0 = meta[S + 1 + m], j1 = meta[S + 2 + m];
            uint qb = meta[2 * S + 2 + m] + (r0 - meta[m]);
            for (uint j = j0 + js; j < j1; j += JS) {
                float w[RQ];
                if (RQ == 4) {
                    float4 v = suc_ld4(cval + qb + (j - j0) * om);
                    w[0] = v.x; w[RQ > 1 ? 1 : 0] = v.y; w[RQ > 2 ? 2 : 0] = v.z; w[RQ > 3 ? 3 : 0] = v.w;
                } else {
                    for (uint q = 0; q < RQ; ++q) w[q] = float(cval[qb + (j - j0) * om + q]);
                }
                for (uint bb = 0; bb < BT; ++bb) {
                    float xv = xg[bb * CTOT + j];
                    for (uint q = 0; q < RQ; ++q) acc[q][bb] += w[q] * xv;
                }
            }
        }
        if (HAS_CSR) {
            float sc = rscale[m];
            for (uint q = 0; q < RQ; ++q) {
                uint r = r0 + q;
                if (r >= OUT) break;
                uint e1 = row_ptr[r + 1];
                for (uint e = row_ptr[r] + js; e < e1; e += JS) {
                    float wv = sc * float(rvals[e]);
                    uint c = rcols[e];
                    for (uint bb = 0; bb < BT; ++bb)
                        if (b0 + bb < B) acc[q][bb] += wv * float(x[(b0 + bb) * IN + c]);
                }
            }
        }
    }
    if (JS > 1) {
        for (uint bb = 0; bb < BT; ++bb)
            for (uint q = 0; q < RQ; ++q) red[(js * BT + bb) * TR + lane * RQ + q] = acc[q][bb];
        threadgroup_barrier(mem_flags::mem_threadgroup);
        for (uint t = tid; t < BT * TR; t += tn) {
            uint bb = t / TR, rr = t - bb * TR;
            uint r = rt0 + rr, b = b0 + bb;
            if (r >= OUT || b >= B) continue;
            float v = 0.0f;
            for (uint s = 0; s < JS; ++s) v += red[(s * BT + bb) * TR + rr];
            y[b * OUT + r] = OT(y_in[b * OUT + r] + v);
        }
    } else {
        for (uint q = 0; q < RQ; ++q) {
            uint r = r0 + q;
            if (r >= OUT) break;
            for (uint bb = 0; bb < BT; ++bb) {
                uint b = b0 + bb;
                if (b < B) y[b * OUT + r] = OT(y_in[b * OUT + r] + acc[q][bb]);
            }
        }
    }
}

// ====================================================================================================
// suc_switch_lookup_vec: suc.kernels.suc_switch._PROLOGUE + vq_matmul _LOOKUP_SRC (gather_matmul_metal)
// ====================================================================================================
template <typename T, int BT, int OUT, int IN, int NG, int G, int K, int BITS, int WORDS, int CBE, int SG, int M, int R,
          int VEC, int CBTG, int HM, typename TO, typename TS>
[[kernel]] void suc_switch_lookup_vec(
    const device T* x [[buffer(0)]],
    const device half* codebook [[buffer(1)]],
    const device uint32_t* packed [[buffer(2)]],
    const device TS* scales [[buffer(3)]],
    const device uint32_t* eidx [[buffer(4)]],
    device TO* y [[buffer(5)]],
    uint3 thread_position_in_grid [[thread_position_in_grid]],
    uint3 thread_position_in_threadgroup [[thread_position_in_threadgroup]],
    uint3 threadgroup_position_in_grid [[threadgroup_position_in_grid]],
    uint3 threads_per_threadgroup [[threads_per_threadgroup]],
    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]],
    uint thread_index_in_simdgroup [[thread_index_in_simdgroup]]) {

    {
        uint suc_t = threadgroup_position_in_grid.y;
        ulong suc_e = ulong(eidx[suc_t]);
        codebook += suc_e * ulong(CBE * M * K * G);
        packed += suc_e * ulong(M * OUT * WORDS);
        scales += suc_e * ulong(OUT);
        x += ulong(suc_t) * ulong(BT * IN);
        y += ulong(suc_t) * ulong(BT * OUT);
    }

    // Index units. CHUNK (aligned widths, BITS | 32, and the unaligned widths where it measured faster): a lane step
    // reads VEC chunks of CW consecutive uint32 words holding GPU whole groups (CW·32 = lcm(BITS, 32) bits: 6 bits →
    // 3 words / 16 groups, 9 bits → 9 words / 32 groups); group j of a chunk sits at a compile-time bit offset once
    // the j loop is unrolled, so every word is loaded once and unpacking is a constant shift / or / mask. Groups are
    // consumed XS at a time so that x is read in 4-element vectors (XS·G % 4 == 0: G = 2 → 2 groups = one half4,
    // G = 3 → 4 groups = three half4). Otherwise one group per lane step (lanes on consecutive groups, suc_unpack).
    constexpr uint GCD = (BITS & (~BITS + 1u)) < 32u ? (BITS & (~BITS + 1u)) : 32u;   // gcd(BITS, 32)
    constexpr bool ALIGNED = GCD == BITS;
    constexpr bool CHUNK = ALIGNED || (G % 2 == 0 && BT <= 6) || (BT <= 2 && BITS / GCD <= 3);
    constexpr uint CW = BITS / GCD;
    constexpr uint GPU = 32 / GCD;
    constexpr uint NU = (NG + GPU - 1) / GPU;
    constexpr uint MASK = BITS >= 32 ? 0xffffffffu : ((1u << BITS) - 1u);
    constexpr uint XS0 = G % 2 == 0 && G % 4 != 0 ? 2 : 1;   // odd G: 4-group spans measured slower (registers)
    constexpr uint XS = (!HM && IN % 4 == 0 && GPU % XS0 == 0) ? XS0 : 1;
    threadgroup half cbt[CBTG ? M * K * G : 2];
    if (CBTG) {
        for (uint i = thread_position_in_threadgroup.x; i < M * K * G; i += SG * 32) cbt[i] = codebook[i];
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    uint lane = thread_index_in_simdgroup;
    uint row0 = (threadgroup_position_in_grid.x * SG + simdgroup_index_in_threadgroup) * R;
    if (row0 >= OUT) return;
    uint rows[R];
    for (int rr = 0; rr < R; ++rr) rows[rr] = min(row0 + rr, uint(OUT - 1));   // tail rows: computed, not stored
    float acc[R][BT];
    for (int rr = 0; rr < R; ++rr) for (int b = 0; b < BT; ++b) acc[rr][b] = 0.0f;

    auto prow_of = [&](int m, int rr) { return packed + (m * OUT + rows[rr]) * WORDS; };   // packed row of (m, rr)
    // acc[rr][b] += <Σ_m C_m[ix[m][s][rr]], x[b, (g + s)G : (g + s + 1)G]> over the S groups g .. g + S - 1
    auto groups_dot = [&](uint g, auto S, thread const uint (&ix)[M][XS][R]) {
        constexpr uint NS = decltype(S)::value;
        if (HM) {
            // half math (fp16 x, M = 1, G % 4 == 0): half4 products summed by dot(), float accumulation
            constexpr int G4 = G / 4 > 0 ? G / 4 : 1;
            half4 e[R][G4];
            for (int rr = 0; rr < R; ++rr) {
                const device half4* ep = (const device half4*)(codebook + ix[0][0][rr] * G);
                for (int q = 0; q < G4; ++q) e[rr][q] = ep[q];
            }
            for (int b = 0; b < BT; ++b) {
                half4 xv[G4];
                for (int q = 0; q < G4; ++q) xv[q] = suc_ldh4(x + b * IN + g * G + 4 * q);
                for (int rr = 0; rr < R; ++rr) {
                    float d = 0.0f;
                    for (int q = 0; q < G4; ++q) d += float(dot(e[rr][q], xv[q]));
                    acc[rr][b] += d;
                }
            }
            return;
        }
        float c[R][NS * G];
        for (int rr = 0; rr < R; ++rr) {
            for (uint q = 0; q < NS * G; ++q) c[rr][q] = 0.0f;
            for (uint sj = 0; sj < NS; ++sj)
                for (int m = 0; m < M; ++m) {
                    uint idx = ix[m][sj][rr];
                    if (CBTG) cb_add<G>(cbt + (m * K + idx) * G, c[rr] + sj * G);
                    else cb_add<G>(codebook + (m * K + idx) * G, c[rr] + sj * G);
                }
        }
        for (int b = 0; b < BT; ++b) {
            float xv[NS * G];
            XLoad<T, NS * G>::run(x + b * IN + g * G, xv);
            for (int rr = 0; rr < R; ++rr) {
                float d = 0.0f;
                for (uint q = 0; q < NS * G; ++q) d += c[rr][q] * xv[q];
                acc[rr][b] += d;
            }
        }
    };

    if (CHUNK) {
        // VEC consecutive units per lane step; VEC = 4 with one-word units and 16-byte aligned rows → one uint4 load
        constexpr bool V4 = CW == 1 && VEC == 4 && (WORDS % 4) == 0;
        for (uint u0 = lane * VEC; u0 < NU; u0 += 32 * VEC) {
            uint wd[M][R][VEC * CW];
            for (int m = 0; m < M; ++m)
                for (int rr = 0; rr < R; ++rr) {
                    auto prow = prow_of(m, rr);
                    if (V4) {
                        uint4 q = ((const device uint4*)prow)[u0 / 4];
                        wd[m][rr][0] = q.x; wd[m][rr][1] = q.y; wd[m][rr][2] = q.z; wd[m][rr][3] = q.w;
                    } else {
                        #pragma clang loop unroll(full)
                        for (uint v = 0; v < VEC * CW; ++v) wd[m][rr][v] = prow[min(u0 * CW + v, uint(WORDS - 1))];
                    }
                }
            #pragma clang loop unroll(full)
            for (uint v = 0; v < VEC; ++v) {
                uint u = u0 + v;
                if (VEC > 1 && u >= NU) break;
                #pragma clang loop unroll(full)
                for (uint j0 = 0; j0 < GPU; j0 += XS) {
                    uint g = u * GPU + j0;
                    if (NG % GPU != 0 && g >= NG) break;
                    // bit offsets of groups j0 .. j0 + XS - 1 inside the chunk (compile-time after unrolling)
                    uint ix[M][XS][R];
                    for (uint sj = 0; sj < XS; ++sj) {
                        const uint jw = v * CW + ((j0 + sj) * BITS) / 32, joff = ((j0 + sj) * BITS) % 32;
                        for (int m = 0; m < M; ++m)
                            for (int rr = 0; rr < R; ++rr) ix[m][sj][rr] = suc_bits<BITS>(wd[m][rr], jw, joff) & MASK;
                    }
                    if (XS == 1 || NG % XS == 0 || g + XS <= NG) {
                        groups_dot(g, integral_constant<uint, XS>(), ix);
                    } else {                       // partial last span (NG % XS != 0): one group at a time
                        for (uint sj = 0; sj < XS && g + sj < NG; ++sj) {
                            uint ix1[M][XS][R];
                            for (int m = 0; m < M; ++m)
                                for (int rr = 0; rr < R; ++rr) ix1[m][0][rr] = ix[m][sj][rr];
                            groups_dot(g + sj, integral_constant<uint, 1>(), ix1);
                        }
                    }
                }
            }
        }
    } else {
        for (uint g = lane; g < NG; g += 32) {
            uint ix[M][XS][R];
            for (int m = 0; m < M; ++m)
                for (int rr = 0; rr < R; ++rr) ix[m][0][rr] = suc_unpack<BITS>(prow_of(m, rr), g);
            groups_dot(g, integral_constant<uint, 1>(), ix);
        }
    }
    for (int rr = 0; rr < R; ++rr) {
        uint row = row0 + rr;
        float s = scales[rows[rr]];
        for (int b = 0; b < BT; ++b) {
            float t = simd_sum(acc[rr][b]);
            if (lane == 0 && row < OUT) y[b * OUT + row] = static_cast<TO>(t * s);
        }
    }
}

// ====================================================================================================
// suc_switch_lookup_vec_tab: offset-table prologue (C++ only) + the same body
// ====================================================================================================
template <typename T, int BT, int OUT, int IN, int NG, int G, int K, int BITS, int WORDS, int CBE, int SG, int M, int R,
          int VEC, int CBTG, int HM, typename TO, typename TS>
[[kernel]] void suc_switch_lookup_vec_tab(
    const device T* x [[buffer(0)]],
    const device half* codebook [[buffer(1)]],
    const device uint32_t* packed [[buffer(2)]],
    const device TS* scales [[buffer(3)]],
    const device uint32_t* eidx [[buffer(4)]],
    device TO* y [[buffer(5)]],
    const device ulong* eoff [[buffer(6)]],
    uint3 thread_position_in_grid [[thread_position_in_grid]],
    uint3 thread_position_in_threadgroup [[thread_position_in_threadgroup]],
    uint3 threadgroup_position_in_grid [[threadgroup_position_in_grid]],
    uint3 threads_per_threadgroup [[threads_per_threadgroup]],
    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]],
    uint thread_index_in_simdgroup [[thread_index_in_simdgroup]]) {

    {
        uint suc_t = threadgroup_position_in_grid.y;
        ulong suc_e = ulong(eidx[suc_t]);
        if (eoff[3 * suc_e + 1] == ~0ul) return;
        codebook += CBE ? eoff[3 * suc_e] : 0ul;
        packed += eoff[3 * suc_e + 1];
        scales += eoff[3 * suc_e + 2];
        x += ulong(suc_t) * ulong(BT * IN);
        y += ulong(suc_t) * ulong(BT * OUT);
    }

    // Index units. CHUNK (aligned widths, BITS | 32, and the unaligned widths where it measured faster): a lane step
    // reads VEC chunks of CW consecutive uint32 words holding GPU whole groups (CW·32 = lcm(BITS, 32) bits: 6 bits →
    // 3 words / 16 groups, 9 bits → 9 words / 32 groups); group j of a chunk sits at a compile-time bit offset once
    // the j loop is unrolled, so every word is loaded once and unpacking is a constant shift / or / mask. Groups are
    // consumed XS at a time so that x is read in 4-element vectors (XS·G % 4 == 0: G = 2 → 2 groups = one half4,
    // G = 3 → 4 groups = three half4). Otherwise one group per lane step (lanes on consecutive groups, suc_unpack).
    constexpr uint GCD = (BITS & (~BITS + 1u)) < 32u ? (BITS & (~BITS + 1u)) : 32u;   // gcd(BITS, 32)
    constexpr bool ALIGNED = GCD == BITS;
    constexpr bool CHUNK = ALIGNED || (G % 2 == 0 && BT <= 6) || (BT <= 2 && BITS / GCD <= 3);
    constexpr uint CW = BITS / GCD;
    constexpr uint GPU = 32 / GCD;
    constexpr uint NU = (NG + GPU - 1) / GPU;
    constexpr uint MASK = BITS >= 32 ? 0xffffffffu : ((1u << BITS) - 1u);
    constexpr uint XS0 = G % 2 == 0 && G % 4 != 0 ? 2 : 1;   // odd G: 4-group spans measured slower (registers)
    constexpr uint XS = (!HM && IN % 4 == 0 && GPU % XS0 == 0) ? XS0 : 1;
    threadgroup half cbt[CBTG ? M * K * G : 2];
    if (CBTG) {
        for (uint i = thread_position_in_threadgroup.x; i < M * K * G; i += SG * 32) cbt[i] = codebook[i];
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }

    uint lane = thread_index_in_simdgroup;
    uint row0 = (threadgroup_position_in_grid.x * SG + simdgroup_index_in_threadgroup) * R;
    if (row0 >= OUT) return;
    uint rows[R];
    for (int rr = 0; rr < R; ++rr) rows[rr] = min(row0 + rr, uint(OUT - 1));   // tail rows: computed, not stored
    float acc[R][BT];
    for (int rr = 0; rr < R; ++rr) for (int b = 0; b < BT; ++b) acc[rr][b] = 0.0f;

    auto prow_of = [&](int m, int rr) { return packed + (m * OUT + rows[rr]) * WORDS; };   // packed row of (m, rr)
    // acc[rr][b] += <Σ_m C_m[ix[m][s][rr]], x[b, (g + s)G : (g + s + 1)G]> over the S groups g .. g + S - 1
    auto groups_dot = [&](uint g, auto S, thread const uint (&ix)[M][XS][R]) {
        constexpr uint NS = decltype(S)::value;
        if (HM) {
            // half math (fp16 x, M = 1, G % 4 == 0): half4 products summed by dot(), float accumulation
            constexpr int G4 = G / 4 > 0 ? G / 4 : 1;
            half4 e[R][G4];
            for (int rr = 0; rr < R; ++rr) {
                const device half4* ep = (const device half4*)(codebook + ix[0][0][rr] * G);
                for (int q = 0; q < G4; ++q) e[rr][q] = ep[q];
            }
            for (int b = 0; b < BT; ++b) {
                half4 xv[G4];
                for (int q = 0; q < G4; ++q) xv[q] = suc_ldh4(x + b * IN + g * G + 4 * q);
                for (int rr = 0; rr < R; ++rr) {
                    float d = 0.0f;
                    for (int q = 0; q < G4; ++q) d += float(dot(e[rr][q], xv[q]));
                    acc[rr][b] += d;
                }
            }
            return;
        }
        float c[R][NS * G];
        for (int rr = 0; rr < R; ++rr) {
            for (uint q = 0; q < NS * G; ++q) c[rr][q] = 0.0f;
            for (uint sj = 0; sj < NS; ++sj)
                for (int m = 0; m < M; ++m) {
                    uint idx = ix[m][sj][rr];
                    if (CBTG) cb_add<G>(cbt + (m * K + idx) * G, c[rr] + sj * G);
                    else cb_add<G>(codebook + (m * K + idx) * G, c[rr] + sj * G);
                }
        }
        for (int b = 0; b < BT; ++b) {
            float xv[NS * G];
            XLoad<T, NS * G>::run(x + b * IN + g * G, xv);
            for (int rr = 0; rr < R; ++rr) {
                float d = 0.0f;
                for (uint q = 0; q < NS * G; ++q) d += c[rr][q] * xv[q];
                acc[rr][b] += d;
            }
        }
    };

    if (CHUNK) {
        // VEC consecutive units per lane step; VEC = 4 with one-word units and 16-byte aligned rows → one uint4 load
        constexpr bool V4 = CW == 1 && VEC == 4 && (WORDS % 4) == 0;
        for (uint u0 = lane * VEC; u0 < NU; u0 += 32 * VEC) {
            uint wd[M][R][VEC * CW];
            for (int m = 0; m < M; ++m)
                for (int rr = 0; rr < R; ++rr) {
                    auto prow = prow_of(m, rr);
                    if (V4) {
                        uint4 q = ((const device uint4*)prow)[u0 / 4];
                        wd[m][rr][0] = q.x; wd[m][rr][1] = q.y; wd[m][rr][2] = q.z; wd[m][rr][3] = q.w;
                    } else {
                        #pragma clang loop unroll(full)
                        for (uint v = 0; v < VEC * CW; ++v) wd[m][rr][v] = prow[min(u0 * CW + v, uint(WORDS - 1))];
                    }
                }
            #pragma clang loop unroll(full)
            for (uint v = 0; v < VEC; ++v) {
                uint u = u0 + v;
                if (VEC > 1 && u >= NU) break;
                #pragma clang loop unroll(full)
                for (uint j0 = 0; j0 < GPU; j0 += XS) {
                    uint g = u * GPU + j0;
                    if (NG % GPU != 0 && g >= NG) break;
                    // bit offsets of groups j0 .. j0 + XS - 1 inside the chunk (compile-time after unrolling)
                    uint ix[M][XS][R];
                    for (uint sj = 0; sj < XS; ++sj) {
                        const uint jw = v * CW + ((j0 + sj) * BITS) / 32, joff = ((j0 + sj) * BITS) % 32;
                        for (int m = 0; m < M; ++m)
                            for (int rr = 0; rr < R; ++rr) ix[m][sj][rr] = suc_bits<BITS>(wd[m][rr], jw, joff) & MASK;
                    }
                    if (XS == 1 || NG % XS == 0 || g + XS <= NG) {
                        groups_dot(g, integral_constant<uint, XS>(), ix);
                    } else {                       // partial last span (NG % XS != 0): one group at a time
                        for (uint sj = 0; sj < XS && g + sj < NG; ++sj) {
                            uint ix1[M][XS][R];
                            for (int m = 0; m < M; ++m)
                                for (int rr = 0; rr < R; ++rr) ix1[m][0][rr] = ix[m][sj][rr];
                            groups_dot(g + sj, integral_constant<uint, 1>(), ix1);
                        }
                    }
                }
            }
        }
    } else {
        for (uint g = lane; g < NG; g += 32) {
            uint ix[M][XS][R];
            for (int m = 0; m < M; ++m)
                for (int rr = 0; rr < R; ++rr) ix[m][0][rr] = suc_unpack<BITS>(prow_of(m, rr), g);
            groups_dot(g, integral_constant<uint, 1>(), ix);
        }
    }
    for (int rr = 0; rr < R; ++rr) {
        uint row = row0 + rr;
        float s = scales[rows[rr]];
        for (int b = 0; b < BT; ++b) {
            float t = simd_sum(acc[rr][b]);
            if (lane == 0 && row < OUT) y[b * OUT + row] = static_cast<TO>(t * s);
        }
    }
}

// ====================================================================================================
// suc_switch_lookup_mma: suc.kernels.suc_switch._PROLOGUE + vq_matmul _MMA_REG_SRC (gather_matmul_metal)
// ====================================================================================================
template <typename T, int BT, int OUT, int IN, int NG, int G, int K, int BITS, int WORDS, int CBE, int SG, int M, int RT,
          int NB, int KCG, typename TT, int CBTG, typename TO, typename TS>
[[kernel]] void suc_switch_lookup_mma(
    const device T* x [[buffer(0)]],
    const device half* codebook [[buffer(1)]],
    const device uint32_t* packed [[buffer(2)]],
    const device TS* scales [[buffer(3)]],
    const device uint32_t* eidx [[buffer(4)]],
    device TO* y [[buffer(5)]],
    uint3 thread_position_in_grid [[thread_position_in_grid]],
    uint3 thread_position_in_threadgroup [[thread_position_in_threadgroup]],
    uint3 threadgroup_position_in_grid [[threadgroup_position_in_grid]],
    uint3 threads_per_threadgroup [[threads_per_threadgroup]],
    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]],
    uint thread_index_in_simdgroup [[thread_index_in_simdgroup]]) {

    {
        uint suc_t = threadgroup_position_in_grid.y;
        ulong suc_e = ulong(eidx[suc_t]);
        codebook += suc_e * ulong(CBE * M * K * G);
        packed += suc_e * ulong(M * OUT * WORDS);
        scales += suc_e * ulong(OUT);
        x += ulong(suc_t) * ulong(BT * IN);
        y += ulong(suc_t) * ulong(BT * OUT);
    }

    // groups per lane and block for G = 2: 4 (one 8-column word span per lane) up to 8 batch rows; at NB ≥ 2 the
    // c[RT][8] registers cost more than the saved index fetches (M3 A/B 1 / 2 / 4, module docstring "Low G")
    constexpr uint PGG2 = NB >= 2 ? 1 : 4;
    constexpr bool ALIGNED = (32 % BITS) == 0;
    constexpr uint GPU = ALIGNED ? 32 / BITS : 1;
    constexpr uint MASK = BITS >= 32 ? 0xffffffffu : ((1u << BITS) - 1u);
    constexpr uint RW = 8 * RT;
    threadgroup half cbt[CBTG ? M * K * G : 2];
    if (CBTG) {
        for (uint i = thread_position_in_threadgroup.x; i < M * K * G; i += SG * 32) cbt[i] = codebook[i];
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    uint sg = simdgroup_index_in_threadgroup;
    uint lane = thread_index_in_simdgroup;
    uint row0 = (threadgroup_position_in_grid.x * SG + sg) * RW;
    if (row0 >= OUT) return;
    uint qid = lane / 4;
    uint fm = (qid & 4) + (lane / 2) % 4;
    uint fn = (qid & 2) * 2 + (lane % 2) * 2;
    uint rows[RT];
    bool rlive[RT];
    for (int rt = 0; rt < RT; ++rt) {
        uint r = row0 + rt * 8 + fm;
        rlive[rt] = r < OUT;
        rows[rt] = min(r, uint(OUT - 1));
    }
    simdgroup_matrix<float, 8, 8> acc[RT][NB];
    for (int rt = 0; rt < RT; ++rt)
        for (int nb = 0; nb < NB; ++nb) acc[rt][nb] = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);

    auto prow_of = [&](uint m, uint row) { return packed + (m * OUT + row) * WORDS; };   // packed row of (m, row)
    auto index_of = [&](uint m, uint row, uint gi) -> uint {
        auto prow = prow_of(m, row);
        return ALIGNED ? (prow[gi / GPU] >> ((gi % GPU) * BITS)) & MASK : suc_unpack<BITS>(prow, gi);
    };
    // K permuted inside each block of 4·PG groups (4·PG·G columns, PG·G/2 k-steps): lane (fm, fn = 2f) owns the PG
    // consecutive groups f·PG .. f·PG + PG - 1 of the block (PG·G contiguous columns); in k-step p its fragment
    // columns fn + e are physical columns blk0 + f·PG·G + 2p + e. One index fetch per PG groups (PG > 1: the PG
    // indices come from one word pair) and whole-entry codebook reads (G/4 half4 or G/2 half2). The same
    // permutation on the x fragment (row fm ↦ blk0 + (fm/2)·PG·G + 2p + fm%2) leaves the MMA sum unchanged.
    // PG = 1 for even G ≥ 4 (the K3 layout), 2 for odd G (a pair of columns never straddles an owned span), PGG2
    // for G = 2.
    constexpr uint PG = G % 2 != 0 ? 2 : (G == 2 ? PGG2 : 1);
    constexpr uint SPAN = PG * G;
    // indices of groups gi .. gi + PG - 1 of one row (PG·BITS ≤ 33 bits: within one word pair)
    auto indices_of = [&](uint m, uint row, uint gi, thread uint* ix) {
        auto prow = prow_of(m, row);
        if (PG == 1 || PG * BITS > 33) {
            for (uint t = 0; t < PG; ++t) ix[t] = gi + t < NG ? index_of(m, row, gi + t) : 0u;
            return;
        }
        uint p0 = gi * BITS, wi = p0 / 32, off0 = p0 % 32;
        uint lo = prow[wi], hi = wi + 1 < WORDS ? prow[wi + 1] : 0u;
        for (uint t = 0; t < PG; ++t) {
            uint off = off0 + t * BITS, v;
            if (off >= 32) v = hi >> (off - 32);
            else v = (lo >> off) | (off > 0 && off + BITS > 32 ? hi << (32 - off) : 0u);
            ix[t] = v & MASK;
        }
    };
    for (uint blk0 = 0; blk0 < IN; blk0 += 4 * SPAN) {
        uint gi = blk0 / G + (fn / 2) * PG;
        float c[RT][SPAN];
        for (int rt = 0; rt < RT; ++rt) {
            for (uint q = 0; q < SPAN; ++q) c[rt][q] = 0.0f;
            if (gi < NG) {
                for (int m = 0; m < M; ++m) {
                    uint ixs[PG];
                    indices_of(m, rows[rt], gi, ixs);
                    for (uint t = 0; t < PG; ++t) {
                        if (PG > 1 && gi + t >= NG) break;
                        uint idx = ixs[t];
                        if (CBTG) cb_add<G>(cbt + (m * K + idx) * G, c[rt] + t * G);
                        else cb_add<G>(codebook + (m * K + idx) * G, c[rt] + t * G);
                    }
                }
            }
        }
        for (uint p = 0; p < SPAN / 2; ++p) {
            simdgroup_matrix<TT, 8, 8> bx[NB];
            uint pc = blk0 + (fm / 2) * SPAN + 2 * p + (fm % 2);
            bool kin = pc < IN;
            for (int nb = 0; nb < NB; ++nb) {
                uint bb = nb * 8 + fn;
                bx[nb].thread_elements()[0] = (kin && bb < BT) ? TT(x[bb * IN + pc]) : TT(0);
                bx[nb].thread_elements()[1] = (kin && bb + 1 < BT) ? TT(x[(bb + 1) * IN + pc]) : TT(0);
            }
            for (int rt = 0; rt < RT; ++rt) {
                simdgroup_matrix<TT, 8, 8> aw;
                aw.thread_elements()[0] = TT(c[rt][2 * p]);
                aw.thread_elements()[1] = TT(c[rt][2 * p + 1]);
                for (int nb = 0; nb < NB; ++nb)
                    simdgroup_multiply_accumulate(acc[rt][nb], aw, bx[nb], acc[rt][nb]);
            }
        }
    }
    for (int rt = 0; rt < RT; ++rt) {
        if (!rlive[rt]) continue;
        uint r = rows[rt];
        float s = scales[r];
        for (int nb = 0; nb < NB; ++nb) {
            uint b = nb * 8 + fn;
            float2 d = float2(acc[rt][nb].thread_elements()[0], acc[rt][nb].thread_elements()[1]);
            if (b < BT) y[b * OUT + r] = static_cast<TO>(d.x * s);
            if (b + 1 < BT) y[(b + 1) * OUT + r] = static_cast<TO>(d.y * s);
        }
    }
}

// ====================================================================================================
// suc_switch_lookup_mma_tab: offset-table prologue (C++ only) + the same body
// ====================================================================================================
template <typename T, int BT, int OUT, int IN, int NG, int G, int K, int BITS, int WORDS, int CBE, int SG, int M, int RT,
          int NB, int KCG, typename TT, int CBTG, typename TO, typename TS>
[[kernel]] void suc_switch_lookup_mma_tab(
    const device T* x [[buffer(0)]],
    const device half* codebook [[buffer(1)]],
    const device uint32_t* packed [[buffer(2)]],
    const device TS* scales [[buffer(3)]],
    const device uint32_t* eidx [[buffer(4)]],
    device TO* y [[buffer(5)]],
    const device ulong* eoff [[buffer(6)]],
    uint3 thread_position_in_grid [[thread_position_in_grid]],
    uint3 thread_position_in_threadgroup [[thread_position_in_threadgroup]],
    uint3 threadgroup_position_in_grid [[threadgroup_position_in_grid]],
    uint3 threads_per_threadgroup [[threads_per_threadgroup]],
    uint simdgroup_index_in_threadgroup [[simdgroup_index_in_threadgroup]],
    uint thread_index_in_simdgroup [[thread_index_in_simdgroup]]) {

    {
        uint suc_t = threadgroup_position_in_grid.y;
        ulong suc_e = ulong(eidx[suc_t]);
        if (eoff[3 * suc_e + 1] == ~0ul) return;
        codebook += CBE ? eoff[3 * suc_e] : 0ul;
        packed += eoff[3 * suc_e + 1];
        scales += eoff[3 * suc_e + 2];
        x += ulong(suc_t) * ulong(BT * IN);
        y += ulong(suc_t) * ulong(BT * OUT);
    }

    // groups per lane and block for G = 2: 4 (one 8-column word span per lane) up to 8 batch rows; at NB ≥ 2 the
    // c[RT][8] registers cost more than the saved index fetches (M3 A/B 1 / 2 / 4, module docstring "Low G")
    constexpr uint PGG2 = NB >= 2 ? 1 : 4;
    constexpr bool ALIGNED = (32 % BITS) == 0;
    constexpr uint GPU = ALIGNED ? 32 / BITS : 1;
    constexpr uint MASK = BITS >= 32 ? 0xffffffffu : ((1u << BITS) - 1u);
    constexpr uint RW = 8 * RT;
    threadgroup half cbt[CBTG ? M * K * G : 2];
    if (CBTG) {
        for (uint i = thread_position_in_threadgroup.x; i < M * K * G; i += SG * 32) cbt[i] = codebook[i];
        threadgroup_barrier(mem_flags::mem_threadgroup);
    }
    uint sg = simdgroup_index_in_threadgroup;
    uint lane = thread_index_in_simdgroup;
    uint row0 = (threadgroup_position_in_grid.x * SG + sg) * RW;
    if (row0 >= OUT) return;
    uint qid = lane / 4;
    uint fm = (qid & 4) + (lane / 2) % 4;
    uint fn = (qid & 2) * 2 + (lane % 2) * 2;
    uint rows[RT];
    bool rlive[RT];
    for (int rt = 0; rt < RT; ++rt) {
        uint r = row0 + rt * 8 + fm;
        rlive[rt] = r < OUT;
        rows[rt] = min(r, uint(OUT - 1));
    }
    simdgroup_matrix<float, 8, 8> acc[RT][NB];
    for (int rt = 0; rt < RT; ++rt)
        for (int nb = 0; nb < NB; ++nb) acc[rt][nb] = make_filled_simdgroup_matrix<float, 8, 8>(0.0f);

    auto prow_of = [&](uint m, uint row) { return packed + (m * OUT + row) * WORDS; };   // packed row of (m, row)
    auto index_of = [&](uint m, uint row, uint gi) -> uint {
        auto prow = prow_of(m, row);
        return ALIGNED ? (prow[gi / GPU] >> ((gi % GPU) * BITS)) & MASK : suc_unpack<BITS>(prow, gi);
    };
    // K permuted inside each block of 4·PG groups (4·PG·G columns, PG·G/2 k-steps): lane (fm, fn = 2f) owns the PG
    // consecutive groups f·PG .. f·PG + PG - 1 of the block (PG·G contiguous columns); in k-step p its fragment
    // columns fn + e are physical columns blk0 + f·PG·G + 2p + e. One index fetch per PG groups (PG > 1: the PG
    // indices come from one word pair) and whole-entry codebook reads (G/4 half4 or G/2 half2). The same
    // permutation on the x fragment (row fm ↦ blk0 + (fm/2)·PG·G + 2p + fm%2) leaves the MMA sum unchanged.
    // PG = 1 for even G ≥ 4 (the K3 layout), 2 for odd G (a pair of columns never straddles an owned span), PGG2
    // for G = 2.
    constexpr uint PG = G % 2 != 0 ? 2 : (G == 2 ? PGG2 : 1);
    constexpr uint SPAN = PG * G;
    // indices of groups gi .. gi + PG - 1 of one row (PG·BITS ≤ 33 bits: within one word pair)
    auto indices_of = [&](uint m, uint row, uint gi, thread uint* ix) {
        auto prow = prow_of(m, row);
        if (PG == 1 || PG * BITS > 33) {
            for (uint t = 0; t < PG; ++t) ix[t] = gi + t < NG ? index_of(m, row, gi + t) : 0u;
            return;
        }
        uint p0 = gi * BITS, wi = p0 / 32, off0 = p0 % 32;
        uint lo = prow[wi], hi = wi + 1 < WORDS ? prow[wi + 1] : 0u;
        for (uint t = 0; t < PG; ++t) {
            uint off = off0 + t * BITS, v;
            if (off >= 32) v = hi >> (off - 32);
            else v = (lo >> off) | (off > 0 && off + BITS > 32 ? hi << (32 - off) : 0u);
            ix[t] = v & MASK;
        }
    };
    for (uint blk0 = 0; blk0 < IN; blk0 += 4 * SPAN) {
        uint gi = blk0 / G + (fn / 2) * PG;
        float c[RT][SPAN];
        for (int rt = 0; rt < RT; ++rt) {
            for (uint q = 0; q < SPAN; ++q) c[rt][q] = 0.0f;
            if (gi < NG) {
                for (int m = 0; m < M; ++m) {
                    uint ixs[PG];
                    indices_of(m, rows[rt], gi, ixs);
                    for (uint t = 0; t < PG; ++t) {
                        if (PG > 1 && gi + t >= NG) break;
                        uint idx = ixs[t];
                        if (CBTG) cb_add<G>(cbt + (m * K + idx) * G, c[rt] + t * G);
                        else cb_add<G>(codebook + (m * K + idx) * G, c[rt] + t * G);
                    }
                }
            }
        }
        for (uint p = 0; p < SPAN / 2; ++p) {
            simdgroup_matrix<TT, 8, 8> bx[NB];
            uint pc = blk0 + (fm / 2) * SPAN + 2 * p + (fm % 2);
            bool kin = pc < IN;
            for (int nb = 0; nb < NB; ++nb) {
                uint bb = nb * 8 + fn;
                bx[nb].thread_elements()[0] = (kin && bb < BT) ? TT(x[bb * IN + pc]) : TT(0);
                bx[nb].thread_elements()[1] = (kin && bb + 1 < BT) ? TT(x[(bb + 1) * IN + pc]) : TT(0);
            }
            for (int rt = 0; rt < RT; ++rt) {
                simdgroup_matrix<TT, 8, 8> aw;
                aw.thread_elements()[0] = TT(c[rt][2 * p]);
                aw.thread_elements()[1] = TT(c[rt][2 * p + 1]);
                for (int nb = 0; nb < NB; ++nb)
                    simdgroup_multiply_accumulate(acc[rt][nb], aw, bx[nb], acc[rt][nb]);
            }
        }
    }
    for (int rt = 0; rt < RT; ++rt) {
        if (!rlive[rt]) continue;
        uint r = rows[rt];
        float s = scales[r];
        for (int nb = 0; nb < NB; ++nb) {
            uint b = nb * 8 + fn;
            float2 d = float2(acc[rt][nb].thread_elements()[0], acc[rt][nb].thread_elements()[1]);
            if (b < BT) y[b * OUT + r] = static_cast<TO>(d.x * s);
            if (b + 1 < BT) y[(b + 1) * OUT + r] = static_cast<TO>(d.y * s);
        }
    }
}

// ====================================================================================================
// suc_rot_blocks_rows: suc.kernels.rotation._blocks_kernel(nseg=1, split=False, row_signs=True)
// ====================================================================================================

template <typename TX, typename TY, int Q, int T, int C, int INV, int NTOT, int BUFQ, int M0, int P0, int OFF0,
          int GS0, int GE0>
[[kernel]] void suc_rot_blocks_rows(
    const device TX* x [[buffer(0)]],
    const device float* signs [[buffer(1)]],
    const device uint32_t* sidx [[buffer(2)]],
